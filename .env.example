# ─────────────────────────────────────────────────────────────────────────────
# OrgInsight — AI Insights environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# API key for OpenAI-compatible endpoints (e.g. OpenAI, Azure OpenAI, Groq …)
# Leave blank when using a local Ollama instance (no key required).
AI_API_KEY=

# AI endpoint URL (default: local Ollama)
# OpenAI example: https://api.openai.com/v1/chat/completions
# Ollama example: http://localhost:11434/api/generate
AI_ENDPOINT=

# Model name
# OpenAI examples: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Ollama examples: llama3, mistral, phi3
AI_MODEL=llama3
